{
  "name": "java-injeto-pz",
  "version": "0.1.0",
  "private": true,
  "description": "Launcher desktop PTBR para agentes Java do Project Zomboid, sem distribuir mods da Workshop.",
  "author": "Organic",
  "license": "MIT",
  "homepage": "https://github.com/gamerplay20p5-dotcom/java-injeto-pz#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gamerplay20p5-dotcom/java-injeto-pz.git"
  },
  "bugs": { "url": "https://github.com/gamerplay20p5-dotcom/java-injeto-pz/issues" },
  "main": "src/main/index.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tools/verify-ui.cjs",
    "test:agents": "node tools/verify-agents.cjs",
    "test:package": "node tools/verify-package.cjs",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vdf-parser": "1.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "br.organic.javainjeto.pz",
    "productName": "Java Injeto - PZ",
    "artifactName": "Java-Injeto-PZ-${version}-Windows.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**", "src/main/**", "src/preload.cjs", "catalog.json", "package.json", "LICENSE", "docs/TERCEIROS_PTBR.md"],
    "asar": true,
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "requestExecutionLevel": "user" }
  }
}
